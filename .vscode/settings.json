{
    // ===== 编辑器设置 =====
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "files.encoding": "utf8",
    "files.eol": "\r\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // ===== C++ 文件关联 =====
    "files.associations": {
        "*.cxx": "cpp",
        "*.h": "cpp"
    },

    // ===== 编译与 IntelliSense =====
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.compilerPath": "C:/mingw64/bin/g++.exe",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",

    // ===== 搜索排除 =====
    "search.exclude": {
        "build/": true,
        "logs/": true
    },
    "files.exclude": {
        "build/": true,
        "logs/": true,
        "*.exe": true
    },

    // ===== 终端（解决中文乱码） =====
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": [
                "-NoExit",
                "-Command",
                "& { [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); [Console]::InputEncoding = [System.Text.UTF8Encoding]::new(); if ($PSVersionTable.PSVersion.Major -ge 6) { $PSDefaultParameterValues['Out-File:Encoding'] = 'utf8' } }"
            ]
        }
    },
    "terminal.integrated.windowsEnableConpty": true,
    "terminal.integrated.rightClickBehavior": "default"
}
